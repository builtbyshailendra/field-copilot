{
  "title": "field-copilot",
  "uid": "field-copilot",
  "schemaVersion": 39,
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [{"name": "tenant", "type": "query", "datasource": "Prometheus",
    "query": "label_values(fieldcopilot_llm_calls_total, tenant)", "includeAll": true, "multi": true}]},
  "panels": [
    {"type": "stat", "title": "Golden-set quality (running builds)", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "min(fieldcopilot_canary_quality_score)"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}},
    {"type": "stat", "title": "Model spend, last 24h", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "sum(increase(fieldcopilot_llm_cost_usd_total{tenant=~\"$tenant\"}[24h]))"}], "fieldConfig": {"defaults": {"unit": "currencyUSD"}}},
    {"type": "stat", "title": "Approvals waiting", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "sum(fieldcopilot_pending_approvals{tenant=~\"$tenant\"})"}]},
    {"type": "stat", "title": "Injection flags, last 24h", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "sum(increase(fieldcopilot_injection_flags_total{tenant=~\"$tenant\"}[24h]))"}]},
    {"type": "timeseries", "title": "Model calls per second by purpose", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (purpose) (rate(fieldcopilot_llm_calls_total{tenant=~\"$tenant\"}[5m]))", "legendFormat": "{{purpose}}"}]},
    {"type": "timeseries", "title": "Model latency p50 / p95", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.5, sum by (le) (rate(fieldcopilot_llm_latency_seconds_bucket[5m])))", "legendFormat": "p50"},
                 {"expr": "histogram_quantile(0.95, sum by (le) (rate(fieldcopilot_llm_latency_seconds_bucket[5m])))", "legendFormat": "p95"}]},
    {"type": "timeseries", "title": "Tokens per minute", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (direction) (rate(fieldcopilot_llm_tokens_total{tenant=~\"$tenant\"}[5m])) * 60", "legendFormat": "{{direction}}"}]},
    {"type": "timeseries", "title": "Spend per hour by tenant", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
     "targets": [{"expr": "sum by (tenant) (increase(fieldcopilot_llm_cost_usd_total[1h]))", "legendFormat": "{{tenant}}"}]},
    {"type": "timeseries", "title": "Replies by outcome (answered, not in documents, unverified, refusals)", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (outcome) (rate(fieldcopilot_answers_total{tenant=~\"$tenant\"}[15m]))", "legendFormat": "{{outcome}}"}]},
    {"type": "timeseries", "title": "Fallbacks and model errors", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(fieldcopilot_llm_fallbacks_total[5m]))", "legendFormat": "served by fallback model"},
                 {"expr": "sum(rate(fieldcopilot_llm_calls_total{outcome=\"error\"}[5m]))", "legendFormat": "failed after retries"}]},
    {"type": "timeseries", "title": "Approval decisions", "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (status) (increase(fieldcopilot_approvals_total{tenant=~\"$tenant\"}[1h]))", "legendFormat": "{{status}}"}]},
    {"type": "timeseries", "title": "Output policy blocks", "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (rule) (increase(fieldcopilot_policy_violations_total{tenant=~\"$tenant\"}[1h]))", "legendFormat": "{{rule}}"}]}
  ]
}
